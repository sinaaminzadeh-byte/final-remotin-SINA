  "typography": {
    "family_only": "Doran FaNum",
    "files": {
      "regular": "DoranFaNum-Bold.ttf",
      "demibold": "DoranFaNum-Black.ttf",
      "bold": "DoranFaNum-Bold.ttf",
      "black": "DoranFaNum-Black.ttf",
      "cta": "DoranFaNum-ExtraBold.ttf"
    },
    "roles": {
      "body": "bold 700",
      "label": "extraBold 800",
      "title": "black 900",
      "caption": "bold 700",
      "display_number": "black 900"
    },
    "caption_size_px": 72,
    "caption_min_px": 52,
    "caption_max_words": 4,
    "body_logical_min": 34,
    "body_final_min_px": 34,
    "caption_align": "ink-centered; dedicated 120px-high line; 72px Doran glyph metrics",
    "ui_direction": "rtl",
    "centering": "tight ink bounds, not font ascender metrics; center inside explicit component rectangles",
    "overflow": "reduce font within permitted bounds or shorten/reflow; never stretch glyphs horizontally and never render outside the box",
    "micro_label_final_min_px": 26,
    "contrast": {
      "normal_text_min": 4.5,
      "large_text_min": 3.0,
      "note": "Use dark ink on gold; white on dark blue/dark green. Brand green is not used for small text on white."
    },
    "family": "Doran FaNum",
    "role_weights": {
      "heading": 900,
      "price": 900,
      "cta": 800,
      "badge": 800,
      "meta": 700,
      "caption": 700
    }
  },
  "motion": {
    "entry_seconds": 0.45,
    "cue_lead_seconds": 0.26,
    "flip_seconds": 0.5,
    "transition_seconds": 0.25,
    "read_hold_motion": "calm 0–3.5% reframing",
    "time_source": "aligned-words.json + cues.json",
    "caption_delay_seconds": 0.0
  },
  "sources": [
    {
      "url": "https://www.facebook.com/business/ads-guide/update/video/instagram-reels",
      "note": "Official Reels ads guide: leave at least 14% top, 35% bottom, 6% sides free of important elements. Recommends 1440x2560; this project preserves the user's requested 1080x1920 and applies the percentages."
    },
    {
      "url": "https://www.facebook.com/business/help/980593475366490",
      "note": "Official safe-zone guidance: for Reels ads including disclaimers leave bottom 40% clear; verify using Ads Manager Safe zone guardrail. Organic UI may vary."
    }
  ],
  "layout_profile": "balanced-organic-user-selected",
  "motion_semantics": {
    "rule": "Every new semantic clause requires a visual state/relation change anchored to its spoken word; subtitle changes, camera drift and decorative loops do not count. Intentional reading holds must be logged.",
    "max_unexplained_hold_seconds": 2.5,
    "sampling": "Evaluate geometry/state at t=i/60; never duplicate 30fps output frames."
  }
}